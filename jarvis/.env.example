# ============================================================
#  JARVIS configuration.  Copy to `.env` and fill in.
#  Everything except ANTHROPIC_API_KEY is optional -- Jarvis
#  degrades gracefully and simply reports a capability as
#  unavailable if its credentials are missing.
# ============================================================

# --- REQUIRED: the brain -------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model routing.  "fast" answers routine turns, "deep" is used
# for research / reasoning.  Keeping fast on Haiku is what makes
# this cheap -- most turns never touch the expensive model.
JARVIS_FAST_MODEL=claude-haiku-4-5
JARVIS_DEEP_MODEL=claude-sonnet-5

# Hard ceiling on spend.  Jarvis refuses new turns past this and
# tells you, rather than silently running up a bill.
JARVIS_MONTHLY_BUDGET_USD=15.00

# --- Web research (free tier: 2,000 queries/month) -----------
# https://brave.com/search/api/  -> "Free" plan, no card required.
# If unset, Jarvis falls back to scraping DuckDuckGo HTML ($0,
# lower quality, occasionally rate-limited).
BRAVE_API_KEY=

# --- Google: Gmail + Google Calendar -------------------------
# Run `python setup_google.py` once after placing your OAuth
# client file at credentials_google.json.  See README step 3.
GOOGLE_CREDENTIALS_FILE=credentials_google.json
GOOGLE_TOKEN_FILE=token_google.json

# --- Microsoft: Teams / Outlook calendar ---------------------
# Azure app registration client id.  Run `python setup_microsoft.py`
# once to authorise.  See README step 4.
MS_CLIENT_ID=
MS_TENANT_ID=common
MS_TOKEN_FILE=token_microsoft.json

# --- Server --------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Identity, so Jarvis knows who it is talking to.
JARVIS_USER_NAME=Sir
JARVIS_TIMEZONE=America/New_York
